# SDK-root repository. Vendor baseline and generated files are not auto-added.
/*
!/.gitignore
!/Makefile
!/README.md
!/build.sh
!/device/
/device/*
!/device/rockchip/
/device/rockchip/*
!/device/rockchip/.chips/
/device/rockchip/.chips/*
!/device/rockchip/.chips/ok3506/
/device/rockchip/.chips/ok3506/*
!/device/rockchip/.chips/ok3506/OK3506-S-MINI_amp_nand_zephyr_defconfig
!/device/rockchip/.chips/ok3506/amp-zephyr.cfg
!/device/rockchip/.chips/ok3506/amp_linux_zephyr.its
!/device/rockchip/common/
/device/rockchip/common/*
!/device/rockchip/common/Makefile
!/device/rockchip/common/extra-parts/
/device/rockchip/common/extra-parts/*
!/device/rockchip/common/extra-parts/userdata/
/device/rockchip/common/extra-parts/userdata/*
!/device/rockchip/common/extra-parts/userdata/normal/
/device/rockchip/common/extra-parts/userdata/normal/*
!/device/rockchip/common/extra-parts/userdata/normal/rk3506_cache_stress_8h.sh
!/device/rockchip/common/extra-parts/userdata/normal/rk3506_can_dump_regs.sh
!/device/rockchip/common/extra-parts/userdata/normal/rk3506_pb6_gpio_toggle.sh
!/device/rockchip/common/extra-parts/userdata/normal/rk3506_pc0_gpio_input_test.sh
!/device/rockchip/common/scripts/
/device/rockchip/common/scripts/*
!/device/rockchip/common/scripts/build.sh
!/device/rockchip/common/scripts/mk-amp.sh
!/docs/
/docs/*
!/docs/rk3506/
!/kernel-6.1/
/kernel-6.1/*
!/kernel-6.1/arch/
/kernel-6.1/arch/*
!/kernel-6.1/arch/arm/
/kernel-6.1/arch/arm/*
!/kernel-6.1/arch/arm/boot/
/kernel-6.1/arch/arm/boot/*
!/kernel-6.1/arch/arm/boot/dts/
/kernel-6.1/arch/arm/boot/dts/*
!/kernel-6.1/arch/arm/boot/dts/OK3506-S-MINI-common.dtsi
!/kernel-6.1/arch/arm/boot/dts/OK3506-S-MINI_amp_nand.dts
!/kernel-6.1/arch/arm/boot/dts/OK3506-S-MINI_linux_nand.dts
!/kernel-6.1/arch/arm/boot/dts/rk3506-amp.dtsi
!/scripts/
/scripts/*
!/scripts/check_rk3506_zephyr_layout.sh
!/tools/
/tools/*
!/tools/rk3506_rpmsg_char_ping/
/tools/rk3506_rpmsg_char_ping/*
!/tools/rk3506_rpmsg_char_ping/Makefile
!/tools/rk3506_rpmsg_char_ping/rk3506_rpmsg_can.c
!/tools/rk3506_rpmsg_char_ping/rk3506_rpmsg_can_tx.c
!/tools/rk3506_rpmsg_char_ping/rk3506_rpmsg_char_ping.c
!/tools/rk3506_rpmsg_char_ping/rk3506_rpmsg_char_stress.c
!/tools/rk3506_rpmsg_char_ping/rk3506_socketcan_send.c
!/zephyr/

# Zephyr output stays under SDK output/; also ignore accidental in-tree builds.
/zephyr/build/
/zephyr/build-*/
/zephyr/build_*/
/zephyr/twister-out/
/zephyr/.cache/
*~
*.swp
*.tmp

# Native SDK target for the relocated Linux test tools.
!/device/rockchip/common/scripts/mk-rk3506-tools.sh
!/device/rockchip/common/build-hooks/
/device/rockchip/common/build-hooks/*
!/device/rockchip/common/build-hooks/26-rk3506-tools.sh
