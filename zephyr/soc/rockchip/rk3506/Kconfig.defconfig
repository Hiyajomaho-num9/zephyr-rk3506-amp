# SPDX-License-Identifier: Apache-2.0

if SOC_RK3506

config NUM_IRQS
	default 192

config SYS_CLOCK_HW_CYCLES_PER_SEC
	default 24000000

config FLASH_SIZE
	default 0

config FLASH_BASE_ADDRESS
	default 0

config SRAM_BASE_ADDRESS
	default 0x03e00000

config SRAM_SIZE
	default 1024

# CRU is baseline SoC infrastructure (clock gating for UART/CAN/GPIO/...).
# Enable CLOCK_CONTROL by default rather than having each driver select it:
# a driver select creates a Kconfig dependency loop with upstream symbols
# that depend on CLOCK_CONTROL and select GPIO (e.g. I2S_SILABS_SIWX91X).
config CLOCK_CONTROL
	default y

config CLOCK_CONTROL_RK3506_CRU
	default y

if SERIAL

config UART_NS16550
	default y

config UART_NS16550_DW8250_DW_APB
	default y

config UART_NS16550_ACCESS_WORD_ONLY
	default y

endif # SERIAL

endif # SOC_RK3506
