# RK3506 GPIO configuration options

# Copyright (c) 2026
# SPDX-License-Identifier: Apache-2.0

config GPIO_RK3506
	bool "Rockchip RK3506 GPIO driver"
	default y
	depends on DT_HAS_ROCKCHIP_RK3506_GPIO_ENABLED
	depends on SOC_RK3506
	depends on CLOCK_CONTROL
	select PINCTRL
	help
	  Enable GPIO driver for Rockchip RK3506.

	  Depends on (rather than selects) CLOCK_CONTROL: selecting it here
	  creates a dependency loop with upstream symbols that both depend on
	  CLOCK_CONTROL and select GPIO (e.g. I2S_SILABS_SIWX91X).

config GPIO_RK3506_INIT_PRIORITY
	int "RK3506 GPIO driver init priority"
	default 45
	depends on GPIO_RK3506
	help
	  RK3506 GPIO device initialization priority. Must be numerically
	  greater than the clock control and RK3506 pinctrl init priorities
	  so that clock gates and pad configuration are available during init.
