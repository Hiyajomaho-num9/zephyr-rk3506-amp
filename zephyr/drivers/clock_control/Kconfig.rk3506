config CLOCK_CONTROL_RK3506_CRU
	bool "Rockchip RK3506 CRU clock controller"
	default y
	depends on CLOCK_CONTROL
	depends on SOC_RK3506
	depends on DT_HAS_ROCKCHIP_RK3506_CRU_CLOCK_ENABLED
	help
	  Enable minimal RK3506 CRU clock control.  The initial implementation
	  covers the CAN clocks used by the OK3506B-S12 AMP BSP.
