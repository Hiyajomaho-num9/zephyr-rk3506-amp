# SPDX-License-Identifier: Apache-2.0

config CAN_RK3506
	bool "Rockchip RK3506 CAN controller"
	default y
	depends on CAN
	depends on SOC_RK3506
	depends on DT_HAS_ROCKCHIP_RK3506_CANFD_ENABLED
	select CLOCK_CONTROL
	select CLOCK_CONTROL_RK3506_CRU
	select PINCTRL
	select RESET
	select RESET_RK3506_CRU
	help
	  Enable the Rockchip RK3506 CAN controller driver.  The hardware block
	  is CAN-FD capable, but this driver currently exposes only the
	  board-validated Classical CAN API subset.

if CAN_RK3506

config CAN_RK3506_MAX_FILTERS
	int "Maximum number of software RX filters"
	default 8
	range 1 32
	help
	  Number of software filters applied after the hardware acceptance
	  filters admit frames into the internal RX storage.

endif # CAN_RK3506
